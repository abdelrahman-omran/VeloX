{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velox.dev/schemas/scored-pr.schema.json",
  "title": "ScoredPR",
  "description": "A single PR with its latest AI priority score, as returned by GET /api/prs/active.",
  "type": "object",
  "required": ["id", "number", "status", "risk_score", "ai_summary", "updated_at"],
  "properties": {
    "id":          { "type": "string", "minLength": 1, "description": "owner/repo#42" },
    "repo":        { "type": "string" },
    "number":      { "type": "integer", "minimum": 1 },
    "title":       { "type": ["string", "null"] },
    "author":      { "type": ["string", "null"] },
    "html_url":    { "type": ["string", "null"], "format": "uri" },
    "status":      { "type": "string", "enum": ["scoring", "scored", "error"] },
    "risk_score":  { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "readability": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "security":    { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "performance": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "architecture":{ "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "ai_summary":  { "type": ["string", "null"], "description": "Maps to the agent's `reasoning` output." },
    "updated_at":  { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}